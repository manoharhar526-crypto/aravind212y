<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="#141414">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:paddingBottom="6dp" />
    <TextView android:id="@+id/note_body" android:layout_width="match_parent" android:layout_height="match_parent"
        android:textColor="#DDDDDD" android:textSize="13sp" android:maxLines="6" android:ellipsize="end" />
</LinearLayout>
