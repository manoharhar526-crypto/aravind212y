<!-- Tap-to-toggle broadcast receiver — writes pending habit toggles into
     SharedPreferences and refreshes affected widgets. -->
<receiver android:name="com.aravind.habittracker.widgets.HabitToggleReceiver" android:enabled="true" android:exported="false"/>

<!-- Boot receiver — restores periodic widget refresh after device reboot -->
<receiver android:name="com.aravind.habittracker.widgets.BootReceiver" android:enabled="true" android:exported="true" android:directBootAware="true">
    <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
        <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
    </intent-filter>
</receiver>

<!-- AlarmManager target — fires every 30 min to refresh all widgets -->
<receiver android:name="com.aravind.habittracker.widgets.WidgetAlarmReceiver" android:enabled="true" android:exported="false"/>

<!-- Backing service for the Monthly Tracking Grid ListView (collection widget) -->
<service android:name="com.aravind.habittracker.widgets.MonthGridRemoteViewsService"
    android:permission="android.permission.BIND_REMOTEVIEWS"
    android:exported="false"/>
