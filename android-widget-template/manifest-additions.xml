<receiver android:name=".widgets.TodayHabitsWidget" android:exported="true">
    <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
    <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_today_habits"/>
</receiver>

